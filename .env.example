# Copy to .env and fill in. .env is git-ignored.

# Enables Claude-powered features (process narratives, workflow interpretation, triage, Copilot).
# Without a key the app runs fully in offline mode using the rules engine.
ANTHROPIC_API_KEY=

# Model used for all AI features.
ANTHROPIC_MODEL=claude-opus-5

# Force offline mode even when a key is present (1 = on).
# COGNIFI_OFFLINE=1

# Production port for `npm start`, and API port during `npm run dev`.
# PORT=8787
# API_PORT=8787
